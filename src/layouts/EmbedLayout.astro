---
import '@fontsource/share-tech-mono';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="embed-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <!-- For an embed that needs a stylesheet of its own, such as the emote
         catalogue the watchers overlay draws from. -->
    <slot name="head" />
    <!-- A browser source is captured as it is drawn, and in development the
         Astro toolbar is drawn into the corner of it. -->
    <style is:global>astro-dev-toolbar { display: none; }</style>
  </head>
  <body>
    <slot />
  </body>
</html>
