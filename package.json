{
  "name": "dgg-radio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "astro dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "astro build",
    "build:api": "tsup server/index.ts --format esm --platform node --out-dir dist-server --clean --sourcemap",
    "start:api": "node dist-server/index.js",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:test": "docker compose -f compose.yaml -f compose.test.yaml up -d --build",
    "stack:test:down": "docker compose -f compose.yaml -f compose.test.yaml down"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@distube/ytsr": "^2.0.4",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "astro": "^7.2.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.421.2",
    "posthog-node": "^5.51.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "soundcloud.ts": "^0.7.4",
    "tinyduration": "^3.4.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
