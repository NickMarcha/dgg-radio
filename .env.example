# Postgres connection string for the API process. Locally: npm run db:up.
DATABASE_URL=

# Public Netlify site origin and the external Node API origin.
APP_ORIGIN=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787
PORT=8787

# Optional in local development. Use the same PostHog project for browser and server events.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Password for the bundled Postgres. Compose uses it for both the db container
# and the API's DATABASE_URL, so it has no default. Postgres only applies it
# when the data directory is first created — pointing a new password at an
# existing volume fails to authenticate. Use local_only locally, to match the
# DATABASE_URL documented in the README.
POSTGRES_PASSWORD=local_only

# Cloudflare named tunnel token for the self-hosted API. The public hostname
# route is configured in the Cloudflare dashboard, not here, and points at
# http://api:8787 over the compose network.
CLOUDFLARE_TUNNEL_TOKEN=

# Destiny OAuth application values.
DGG_CLIENT_ID=
DGG_CLIENT_SECRET=
DGG_REDIRECT_URI=http://localhost:4321/auth/callback

# Where the OAuth provider lives: the first is what the API calls, the second is
# where the browser is sent to authorize. Both default to https://www.destiny.gg
# and belong unset everywhere except the local test stack, which points them at
# the stand-in in dev/dgg-oauth. The API refuses to start with either one
# elsewhere once APP_ORIGIN is https. compose.test.yaml sets them; nothing else
# should.
DGG_ORIGIN=
DGG_AUTHORIZE_ORIGIN=

# Comma-separated Destiny usernames that become admins on login.
ADMIN_DGG_USERNAMES=

# Server-side media metadata credentials.
YOUTUBE_API_KEY=

# CI-only credentials for source-map uploads. POSTHOG_RELEASE_VERSION should be the commit SHA.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_RELEASE_VERSION=
