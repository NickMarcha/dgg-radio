# Read by `astro dev` only. Vite loads it after .env, and `astro build` runs in
# production mode and never sees it, so a local build still targets whatever
# .env names. This is what points the browser at the local API rather than the
# deployed one, which is what makes `npm run dev` work against
# `npm run stack:test`.
#
# TEST_HOST is the one knob for both halves: compose.test.yaml reads the same
# variable for the API's APP_ORIGIN. Set it in .env, or per command, to reach
# the stack by network address instead of localhost — the Chrome extension
# cannot open a localhost page, and OBS on another machine cannot either.
# Recreate the API afterwards so it expects the matching origin.
PUBLIC_API_URL=http://${TEST_HOST:-localhost}:8787

# Analytics belong to the deployed room. posthog-js is never initialised
# without a key, so a page served from here reports no pageview, no exception
# and no session recording into the project the real room writes to. Blank
# rather than absent, because .env names a real key and this file is what
# overrides it.
PUBLIC_POSTHOG_KEY=
